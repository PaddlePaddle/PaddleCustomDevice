cmake_minimum_required(VERSION 3.10)
set(PYTHON_VERSION "3.8")
project(paddle-custom-gpu LANGUAGES CXX CUDA)  # 添加CUDA语言支持

set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} "${CMAKE_SOURCE_DIR}/cmake")
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/../../Paddle/cmake")
set(CMAKE_VERBOSE_MAKEFILE ON)

include(paddle)
include(version)
include(generic)

# 宏定义
add_definitions(-DPADDLE_WITH_CUSTOM_DEVICE)
add_definitions(-DPADDLE_CUDA_FP16)
add_definitions(-DGPUContext=CustomContext)
add_definitions(-DSTREAM_TYPE=cudaStream_t)

find_package(CUDA REQUIRED)

message(STATUS "CUDA_INCLUDE_DIRS:${CUDA_INCLUDE_DIRS}")
message(STATUS "PADDLE INIT DONE!")

option(WITH_TESTING "compile with unit testing" ON)
option(ON_INFER "compile with inference c++ lib" OFF)
option(WITH_GPU "Compile PaddlePaddle with NVIDIA GPU" ON)

set(PLUGIN_NAME "paddle-custom-gpu")
set(TEST_TARGET "paddle-custom-gpu-test")
set(PLUGIN_VERSION "0.0.1")

# 源文件配置---------------------------------------------------------------
# CUDA源文件（.cu）
set(CUDA_SRCS
    ${PADDLE_SOURCE_DIR}/paddle/phi/kernels/gpu/index_add_kernel.cu
)

# C++源文件（.cc）
set(CC_SRCS
    ${CMAKE_SOURCE_DIR}/kernel_register/index_add_kernel_register.cc
    ${CMAKE_SOURCE_DIR}/runtime/runtime.cc
)

# 设置CUDA源文件属性
set_source_files_properties(${CUDA_SRCS} 
    PROPERTIES 
    LANGUAGE CUDA
    CUDA_STANDARD 14
)

# 合并所有源文件
set(ALL_SRCS
    ${CUDA_SRCS}
    ${CC_SRCS}
)

# 包含目录配置-------------------------------------------------------------
include_directories(
    ${CMAKE_SOURCE_DIR}
    ${PADDLE_SOURCE_DIR}
    ${CMAKE_SOURCE_DIR}/kernels
    ${CUDA_INCLUDE_DIRS}
    # 添加其他必要头文件路径
    ${PADDLE_SOURCE_DIR}/third_party/eigen3
    ${PADDLE_SOURCE_DIR}/build/third_party/install/glog/include
    ${PADDLE_SOURCE_DIR}/build/third_party/install/gflags/include
)

# 构建目标-----------------------------------------------------------------
add_library(${TEST_TARGET} SHARED ${ALL_SRCS})

# 编译选项配置
target_compile_options(${TEST_TARGET} PRIVATE
    $<$<COMPILE_LANGUAGE:CUDA>:-Xcompiler -fPIC>
    $<$<COMPILE_LANGUAGE:CXX>:-std=c++14>
)

# 链接配置
target_link_libraries(${TEST_TARGET} PRIVATE
    glog
    gflags
    ${CUDA_LIBRARIES}
    ${CUDA_cudart_LIBRARY}
    ${PADDLE_CORE_LIB}
)

# 宏定义传递
target_compile_definitions(${TEST_TARGET} PUBLIC
    PADDLE_WITH_CUDA=1
    STREAM_TYPE=cudaStream_t
)

# 打包配置（保持原样）-----------------------------------------------------
configure_file(${CMAKE_CURRENT_SOURCE_DIR}/setup.py.in
               ${CMAKE_CURRENT_BINARY_DIR}/setup.py)
  
add_custom_command(
  TARGET ${TEST_TARGET}
  POST_BUILD
  COMMAND ${CMAKE_COMMAND} -E remove -f ${CMAKE_CURRENT_BINARY_DIR}/python/
  COMMAND ${CMAKE_COMMAND} -E make_directory ${CMAKE_CURRENT_BINARY_DIR}/python/
  COMMAND ${CMAKE_COMMAND} -E make_directory
          ${CMAKE_CURRENT_BINARY_DIR}/python/paddle_custom_device/
  COMMAND
    ${CMAKE_COMMAND} -E copy_if_different
    ${CMAKE_CURRENT_BINARY_DIR}/lib${TEST_TARGET}.so
    ${CMAKE_CURRENT_BINARY_DIR}/python/paddle_custom_device/
  COMMENT "Creating plugin directories------>>>")

add_custom_command(
  OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/python/.timestamp
  COMMAND ${Python_EXECUTABLE} ${CMAKE_CURRENT_BINARY_DIR}/setup.py bdist_wheel
  DEPENDS ${TEST_TARGET}
  COMMENT "Packing whl packages------>>>")

add_custom_target(python_package ALL
                  DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/python/.timestamp)